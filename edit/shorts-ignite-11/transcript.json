			"timestamps": {
				"from": "00:06:34,720",
				"to": "00:06:37,280"
			},
			"offsets": {
				"from": 394720,
				"to": 397280
			},
			"text": " And you gotta know, okay, I know what to do."
		},
		{
			"timestamps": {
				"from": "00:06:37,280",
				"to": "00:06:39,560"
			},
			"offsets": {
				"from": 397280,
				"to": 399560
			},
			"text": " I know how to swap things out."
		},
		{
			"timestamps": {
				"from": "00:06:39,560",
				"to": "00:06:43,200"
			},
			"offsets": {
				"from": 399560,
				"to": 403200
			},
			"text": " Day in, day out, across clusters."
		},
		{
			"timestamps": {
				"from": "00:06:43,200",
				"to": "00:06:44,800"
			},
			"offsets": {
				"from": 403200,
				"to": 404800
			},
			"text": " That's just on the hardware side."
		},
		{
			"timestamps": {
				"from": "00:06:44,800",
				"to": "00:06:48,240"
			},
			"offsets": {
				"from": 404800,
				"to": 408240
			},
			"text": " Manage, procurement, things are not delivered on time."
		},
		{
			"timestamps": {
				"from": "00:06:48,240",
				"to": "00:06:49,800"
			},
			"offsets": {
				"from": 408240,
				"to": 409800
			},
			"text": " It's not pushing a code."
		},
		{
			"timestamps": {
				"from": "00:06:49,800",
				"to": "00:06:50,960"
			},
			"offsets": {
				"from": 409800,
				"to": 410960
			},
			"text": " Research software companies are like,"
		},
		{
			"timestamps": {
				"from": "00:06:50,960",
				"to": "00:06:52,900"
			},
			"offsets": {
				"from": 410960,
				"to": 412900
			},
			"text": " oh, I push a code, it's done."
		},
		{
			"timestamps": {
				"from": "00:06:52,900",
				"to": "00:06:53,920"
			},
			"offsets": {
				"from": 412900,
				"to": 413920
			},
			"text": " This is pushing people."
		},
		{
			"timestamps": {
				"from": "00:06:53,920",
				"to": "00:06:54,960"
			},
			"offsets": {
				"from": 413920,
				"to": 414960
			},
			"text": " How do you push people?"
		},
		{
			"timestamps": {
				"from": "00:06:54,960",
				"to": "00:06:57,840"
			},
			"offsets": {
				"from": 414960,
				"to": 417840
			},
			"text": " It's not like, hey, deliver GPUs, no."
		},
		{
			"timestamps": {
				"from": "00:06:57,840",
				"to": "00:06:59,720"
			},
			"offsets": {
				"from": 417840,
				"to": 419720
			},
			"text": " You go there, you wind and die."
		},
		{
			"timestamps": {
				"from": "00:06:59,720",
				"to": "00:07:01,920"
			},
			"offsets": {
				"from": 419720,
				"to": 421920
			},
			"text": " You're like, hey, I really need this part."
		},
		{
			"timestamps": {
				"from": "00:07:01,920",
				"to": "00:07:03,720"
			},
			"offsets": {
				"from": 421920,
				"to": 423720
			},
			"text": " I know you have a big order with Google,"
		},
		{
			"timestamps": {
				"from": "00:07:03,720",
				"to": "00:07:06,440"
			},
			"offsets": {
				"from": 423720,
				"to": 426440
			},
			"text": " but spares 10 servers."
		},
		{
			"timestamps": {
				"from": "00:07:06,440",
				"to": "00:07:07,640"
			},
			"offsets": {
				"from": 426440,
				"to": 427640
			},
			"text": " - I think you have famously said"
		},
		{
			"timestamps": {
				"from": "00:07:07,640",
				"to": "00:07:10,840"
			},
			"offsets": {
				"from": 427640,
				"to": 430840
			},
			"text": " that AI infrastructure delivery date is a promise, right?"
		},
		{
			"timestamps": {
				"from": "00:07:10,840",
				"to": "00:07:12,400"
			},
			"offsets": {
				"from": 430840,
				"to": 432400
			},
			"text": " - It's a promise, exactly."
		},
		{
			"timestamps": {
				"from": "00:07:12,400",
				"to": "00:07:14,480"
			},
			"offsets": {
				"from": 432400,
				"to": 434480
			},
			"text": " So I think that matters a lot."
		},
		{
			"timestamps": {
				"from": "00:07:14,480",
				"to": "00:07:17,560"
			},
			"offsets": {
				"from": 434480,
				"to": 437560
			},
			"text": " And how we differentiate from pure,"
		},
		{
			"timestamps": {
				"from": "00:07:17,560",
				"to": "00:07:19,440"
			},
			"offsets": {
				"from": 437560,
				"to": 439440
			},
			"text": " I would say, inference company"
		},
		{
			"timestamps": {
				"from": "00:07:19,440",
				"to": "00:07:22,280"
			},
			"offsets": {
				"from": 439440,
				"to": 442280
			},
			"text": " is because we have this operation excellence."
		},
		{
			"timestamps": {
				"from": "00:07:22,280",
				"to": "00:07:24,760"
			},
			"offsets": {
				"from": 442280,
				"to": 444760
			},
			"text": " It's not just that, but also two other factors will be,"
		},
		{
			"timestamps": {
				"from": "00:07:24,760",
				"to": "00:07:28,360"
			},
			"offsets": {
				"from": 444760,
				"to": 448360
			},
			"text": " we operate clusters across East and West, US and Asia."
		},
		{
			"timestamps": {
				"from": "00:07:28,360",
				"to": "00:07:32,440"
			},
			"offsets": {
				"from": 448360,
				"to": 452440
			},
			"text": " And so we offer a differentiated approach to folks."
		},
		{
			"timestamps": {
				"from": "00:07:32,440",
				"to": "00:07:35,900"
			},
			"offsets": {
				"from": 452440,
				"to": 455900
			},
			"text": " And third will be the, I would say, the full stack approach,"
		},
		{
			"timestamps": {
				"from": "00:07:35,900",
				"to": "00:07:37,660"
			},
			"offsets": {
				"from": 455900,
				"to": 457660
			},
			"text": " where we are a full stack company,"
		},
		{
			"timestamps": {
				"from": "00:07:37,660",
				"to": "00:07:41,120"
			},
			"offsets": {
				"from": 457660,
				"to": 461120
			},
			"text": " from the bare metals to Kubernetes to the inference,"
		},
		{
			"timestamps": {
				"from": "00:07:41,120",
				"to": "00:07:43,640"
			},
			"offsets": {
				"from": 461120,
				"to": 463640
			},
			"text": " as well as the agent inference."
		},
		{
			"timestamps": {
				"from": "00:07:43,640",
				"to": "00:07:45,120"
			},
			"offsets": {
				"from": 463640,
				"to": 465120
			},
			"text": " - So just to wrap up,"
		},
		{
			"timestamps": {
				"from": "00:07:45,120",
				"to": "00:07:47,080"
			},
			"offsets": {
				"from": 465120,
				"to": 467080
			},
			"text": " there are now many, many new clouds, right?"
		},
		{
			"timestamps": {
				"from": "00:07:47,080",
				"to": "00:07:49,200"
			},
			"offsets": {
				"from": 467080,
				"to": 469200
			},
			"text": " It's getting a very proud of space."
		},
		{
			"timestamps": {
				"from": "00:07:49,200",
				"to": "00:07:51,960"
			},
			"offsets": {
				"from": 469200,
				"to": 471960
			},
			"text": " And how do you see this market shaking out?"
		},
		{
			"timestamps": {
				"from": "00:07:51,960",
				"to": "00:07:54,520"
			},
			"offsets": {
				"from": 471960,
				"to": 474520
			},
			"text": " And also you just recently did a very successful fundraise."
		},
		{
			"timestamps": {
				"from": "00:07:54,520",
				"to": "00:07:57,040"
			},
			"offsets": {
				"from": 474520,
				"to": 477040
			},
			"text": " What differentiates you from the rest of them?"
		},
		{
			"timestamps": {
				"from": "00:07:57,040",
				"to": "00:07:59,040"
			},
			"offsets": {
				"from": 477040,
				"to": 479040
			},
			"text": " - Yeah, really great question."
		},
		{
			"timestamps": {
				"from": "00:07:59,040",
				"to": "00:08:01,360"
			},
			"offsets": {
				"from": 479040,
				"to": 481360
			},
			"text": " I would say, just give me takeaway if you like,"
		},
		{
			"timestamps": {
				"from": "00:08:01,360",
				"to": "00:08:04,600"
			},
			"offsets": {
				"from": 481360,
				"to": 484600
			},
			"text": " just forget everything that I say, talk about, right?"
		},
		{
			"timestamps": {
				"from": "00:08:04,600",
				"to": "00:08:08,120"
			},
			"offsets": {
				"from": 484600,
				"to": 488120
			},
			"text": " I'll say, number one is reliability and on time."
		},
		{
			"timestamps": {
				"from": "00:08:09,200",
				"to": "00:08:11,200"
			},
			"offsets": {
				"from": 489200,
				"to": 491200
			},
			"text": " Customer delivery is a promise, right?"
		},
		{
			"timestamps": {
				"from": "00:08:11,200",
				"to": "00:08:13,760"
			},
			"offsets": {
				"from": 491200,
				"to": 493760
			},
			"text": " It's very important and essential to us,"
		},
		{
			"timestamps": {
				"from": "00:08:13,760",
				"to": "00:08:16,540"
			},
			"offsets": {
				"from": 493760,
				"to": 496540
			},
			"text": " which is delivered a very large cluster to our customer."
		},
		{
			"timestamps": {
				"from": "00:08:16,540",
				"to": "00:08:19,320"
			},
			"offsets": {
				"from": 496540,
				"to": 499320
			},
			"text": " We deliver on the dot, exact same time."
		},
		{
			"timestamps": {
				"from": "00:08:19,320",
				"to": "00:08:22,600"
			},
			"offsets": {
				"from": 499320,
				"to": 502600
			},
			"text": " And reliable is impeccable as great, right?"
		},
		{
			"timestamps": {
				"from": "00:08:22,600",
				"to": "00:08:26,120"
			},
			"offsets": {
				"from": 502600,
				"to": 506120
			},
			"text": " And this is, it sounds easy,"
		},
		{
			"timestamps": {
				"from": "00:08:26,120",
				"to": "00:08:30,480"
			},
			"offsets": {
				"from": 506120,
				"to": 510480
			},
			"text": " but it's the grueling details in the operations, right?"
		},
		{
			"timestamps": {
				"from": "00:08:30,480",
				"to": "00:08:32,360"
			},
			"offsets": {
				"from": 510480,
				"to": 512360
			},
			"text": " So number one, supply chain."
		},
		{
			"timestamps": {
				"from": "00:08:32,360",
				"to": "00:08:35,800"
			},
			"offsets": {
				"from": 512360,
				"to": 515800
			},
			"text": " Number two is, as we face a lot of political headwinds"
		},
		{
			"timestamps": {
				"from": "00:08:35,800",
				"to": "00:08:37,660"
			},
			"offsets": {
				"from": 515800,
				"to": 517660
			},
			"text": " in the U.S., right?"
		},
		{
			"timestamps": {
				"from": "00:08:37,660",
				"to": "00:08:41,120"
			},
			"offsets": {
				"from": 517660,
				"to": 521120
			},
			"text": " We have different spots of pockets of power"
		},
		{
			"timestamps": {
				"from": "00:08:41,120",
				"to": "00:08:44,860"
			},
			"offsets": {
				"from": 521120,
				"to": 524860
			},
			"text": " at data center capacities all over the world, Asia and U.S."
		},
		{
			"timestamps": {
				"from": "00:08:44,860",
				"to": "00:08:49,780"
			},
			"offsets": {
				"from": 524860,
				"to": 529780
			},
			"text": " So I'm able to help U.S. companies to land beachhead in Asia"
		},
		{
			"timestamps": {
				"from": "00:08:49,780",
				"to": "00:08:52,540"
			},
			"offsets": {
				"from": 529780,
				"to": 532540
			},
			"text": " tailored towards kind of local data restrictions"
		},
		{
			"timestamps": {
				"from": "00:08:52,540",
				"to": "00:08:56,320"
			},
			"offsets": {
				"from": 532540,
				"to": 536320
			},
			"text": " or data private policies, right, in Asia and vice versa,"
		},
		{
			"timestamps": {
				"from": "00:08:56,320",
				"to": "00:08:59,040"
			},
			"offsets": {
				"from": 536320,
				"to": 539040
			},
			"text": " helping Asia enterprise to go to U.S."
		},
		{
			"timestamps": {
				"from": "00:08:59,040",
				"to": "00:09:01,160"
			},
			"offsets": {
				"from": 539040,
				"to": 541160
			},
			"text": " So we have, it's not just like partnership mode,"
		},
		{
			"timestamps": {
				"from": "00:09:01,160",
				"to": "00:09:05,120"
			},
			"offsets": {
				"from": 541160,
				"to": 545120
			},
			"text": " we have data center there, but we have actual W2 employees"
		},
		{
			"timestamps": {
				"from": "00:09:05,120",
				"to": "00:09:09,120"
			},
			"offsets": {
				"from": 545120,
				"to": 549120
			},
			"text": " in Indonesia and Malaysia and Singapore and Thailand"
		},
		{
			"timestamps": {
				"from": "00:09:09,120",
				"to": "00:09:11,680"
			},
			"offsets": {
				"from": 549120,
				"to": 551680
			},
			"text": " and Taiwan and Japan and same Korea,"
		},
		{
			"timestamps": {
				"from": "00:09:11,680",
				"to": "00:09:13,080"
			},
			"offsets": {
				"from": 551680,
				"to": 553080
			},
			"text": " like people actually on the ground"
		},
		{
			"timestamps": {
				"from": "00:09:13,080",
				"to": "00:09:17,360"
			},
			"offsets": {
				"from": 553080,
				"to": 557360
			},
			"text": " and support DC build out or sales or pre-sale or whatnot."
		},
		{
			"timestamps": {
				"from": "00:09:17,360",
				"to": "00:09:18,760"
			},
			"offsets": {
				"from": 557360,
				"to": 558760
			},
			"text": " - That's really impressive."
		},
		{
			"timestamps": {
				"from": "00:09:18,760",
				"to": "00:09:20,680"
			},
			"offsets": {
				"from": 558760,
				"to": 560680
			},
			"text": " Thank you very much, Alex, for stopping by today"
		},
		{
			"timestamps": {
				"from": "00:09:20,680",
				"to": "00:09:22,320"
			},
			"offsets": {
				"from": 560680,
				"to": 562320
			},
			"text": " and real pleasure speaking with you."
		},
		{
			"timestamps": {
				"from": "00:09:22,320",
				"to": "00:09:23,320"
			},
			"offsets": {
				"from": 562320,
				"to": 563320
			},
			"text": " - Thank you, Steve."
		}
	]
}
